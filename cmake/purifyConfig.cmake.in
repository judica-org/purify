@PACKAGE_INIT@

if(@PURIFY_BUILD_CONSTRUCTION_PARENT_VERIFIER@ AND
   NOT TARGET purify_construction_parent_backend)
    add_library(purify_construction_parent_backend SHARED IMPORTED)
    set_target_properties(purify_construction_parent_backend PROPERTIES
        IMPORTED_LOCATION
            "@PACKAGE_CMAKE_INSTALL_LIBDIR@/@CMAKE_SHARED_LIBRARY_PREFIX@purify_construction_parent@CMAKE_SHARED_LIBRARY_SUFFIX@"
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/purifyTargets.cmake")
